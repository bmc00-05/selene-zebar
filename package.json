{
  "name": "selene-zebar",
  "version": "0.2.0",
  "private": true,
  "description": "A moonlit Zebar status bar for GlazeWM.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "link": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/link.ps1",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 80,
    "arrowParens": "avoid"
  }
}
