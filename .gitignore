# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 작업용 문서(CLAUDE.md · .claude/ · .notes/)는 전역 gitignore 가 막는다.
# dotfiles 의 git/ignore 가 ~/.config/git/ignore 로 링크돼 있다. 어느
# 프로젝트에서도 원격에 올릴 이유가 없어 저장소마다 적지 않는다.

# 백업 파일
# .bak 은 한글(HWP) 백업 확장자로 연결돼 있어, 폴더에 남으면
# 다른 프로그램이 열려고 실행되는 일이 생긴다. 저장소에 두지 않는다.
*.bak
*.bak-*

# 로컬 전용
.env
.env.local
*.local
