# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Claude Code
# settings.json 은 원래 팀 공유용이지만 이 저장소는 혼자 쓴다. 공유할
# 상대가 없는 대신, 하네스가 세션마다 일회성 명령을 허용 목록에 쌓아
# 의미 없는 diff 가 반복해서 올라온다.
.claude/

# 백업 파일
# .bak 은 한글(HWP) 백업 확장자로 연결돼 있어, 폴더에 남으면
# 다른 프로그램이 열려고 실행되는 일이 생긴다. 저장소에 두지 않는다.
*.bak
*.bak-*

# 로컬 전용
.env
.env.local
*.local
