{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "selene-zebar",
  "version": "0.2.0",
  "description": "A moonlit status bar for GlazeWM. Night-sky dark, silver accents, hand-written CSS.",
  "tags": ["topbar", "glazewm", "dark", "minimal"],
  "previewImages": [
    "resources/bar.png",
    "resources/settings.png",
    "resources/states-battery.png"
  ],
  "repositoryUrl": "https://github.com/bo-mun/selene-zebar",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar/index.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "bar/**/*.html",
        "bar/**/*.css",
        "bar/**/*.js",
        "bar/**/*.ps1",
        "bar/**/*.conf",
        "bar/**/*.woff2",
        "bar/**/*.txt",
        "resources/**/*.png"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -NonInteractive -ExecutionPolicy Bypass -File .*[\\\\/]window-icon\\.ps1 \\d+$"
          },
          {
            "program": "cava",
            "argsRegex": "^-p .*[\\\\/]cava\\.conf$"
          },
          {
            "program": "shutdown",
            "argsRegex": "^/[sr] /t 0$"
          },
          {
            "program": "rundll32",
            "argsRegex": "^(user32\\.dll,LockWorkStation|powrprof\\.dll,SetSuspendState 0,1,0)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
